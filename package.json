{
  "name": "aether3d-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Aether3D Studio mobile-first hybrid 3D editor.",
  "main": "auto-run.js",
  "scripts": {
    "build": "node scripts/prepare-web.js && webpack --mode production",
    "build:dev": "node scripts/prepare-web.js && webpack --mode development",
    "cordova:prepare": "npm run build && cordova prepare android",
    "android:build": "npm run build && cordova build android --debug",
    "android:release": "npm run build && cordova build android --release",
    "lint": "node --check auto-run.js && node --check scripts/prepare-web.js && node --check src/js/main.js && node --check src/js/native-bridge.js"
  },
  "dependencies": {"three": "0.180.0"},
  "devDependencies": {
    "@babel/core": "7.26.9",
    "@babel/preset-env": "7.26.9",
    "babel-loader": "10.0.0",
    "cordova": "12.0.0",
    "cordova-android": "13.0.0",
    "css-loader": "7.1.2",
    "javascript-obfuscator": "4.1.1",
    "style-loader": "4.0.0",
    "webpack": "5.98.0",
    "webpack-cli": "6.0.1",
    "webpack-obfuscator": "3.5.1"
  },
  "cordova": {
    "platforms": ["android"],
    "plugins": {"com.aether3d.native": {"source": "src/android"}}
  },
  "engines": {"node": ">=18.0.0"}
}
